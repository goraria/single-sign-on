{
  "name": "@gorth-io/single-sign-on",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "pull": "ncu -u -x eslint,typescript,bun --dep prod,dev,optional,peer,packageManager",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "bun --env-file=.env.local run vitest run --config vitest.cloud.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.28",
    "@better-auth/oauth-provider": "1.7.21",
    "@better-auth/sso": "1.7.21",
    "@faker-js/faker": "^10.6.0",
    "@gorth-io/primitive": "^0.0.0-alpha.10",
    "@gorth-io/principle": "^0.0.0-alpha.10",
    "@gorth-io/structure": "^0.0.0-alpha.10",
    "@hono/vercel": "^1.0.1",
    "@vercel/functions": "^3.11.1",
    "better-auth": "1.7.21",
    "d3-geo": "^3.1.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.18",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.37.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@gorth-io/primitive",
      "@gorth-io/principle",
      "@gorth-io/structure",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "workspaces": [
    "."
  ]
}
