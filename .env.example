# One Next.js + Hono SSO application; no separate port 8080 upstream.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Preserve the exact issuer/public base URL used by existing OAuth clients.
BETTER_AUTH_URL=http://localhost:3000
# Preserve the existing Better Auth secret; do not regenerate during migration.
BETTER_AUTH_SECRET=
NEXT_AUTH_SECRET=
GORTH_COOKIE_PREFIX=gorth
DATABASE_URL=
PG_POOL_MAX=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Gorth
EMAIL_REPLY_TO=

NEXT_PUBLIC_SUPABASE_URL=
